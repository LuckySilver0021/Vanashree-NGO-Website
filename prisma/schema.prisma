// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  fullName        String
  email           String           @unique
  phone           String           @unique
  hashedPassword  String
  age             Int?
  location        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  markers         MapMarker[]
  timelineEntries TimelineEntry[]
  listings        DonationListing[]
  favourites      FavouriteListing[]

  @@map("users")
}

model DonationListing {
  id          String            @id @default(cuid())
  title       String
  description String
  category    String
  condition   String
  location    String
  lat         Float?
  lng         Float?
  imageUrl    String?
  status      String            @default("available")
  sellerId    String
  seller      User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favourites  FavouriteListing[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([category, status])
  @@index([location])
  @@index([sellerId])
  @@map("donation_listings")
}

model FavouriteListing {
  userId    String
  listingId String
  listing   DonationListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@map("favourite_listings")
}

model MapMarker {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  label     String?
  imageUrl  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entries   TimelineEntry[]
  createdAt DateTime @default(now())

  @@map("map_markers")
}

model TimelineEntry {
  id          String   @id @default(cuid())
  markerId    String
  marker      MapMarker @relation(fields: [markerId], references: [id])
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  title       String
  description String
  imageUrl    String?
  status      String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_entries")
}
