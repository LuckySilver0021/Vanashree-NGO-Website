{
  "$schema": "https://v2-8-20.turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true
    },
    "lint": {
      "outputs": []
    }
  }
}
