{
  "name": "@vanashree/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/src/*.js",
      "require": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "react": "19.2.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
